# Local gateway
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8790
GATEWAY_API_KEY=
GATEWAY_API_KEY_FILE=
# Optional; generated in memory when blank. Set it only for multi-process deployments.
MCP_INTERNAL_API_KEY=
MCP_INTERNAL_API_KEY_FILE=

# Provider credentials. Leave unused providers blank.
# Kimi OAuth uses `kimi login`; no password or OAuth token belongs here.
# Optional official K3 API profile. Direct value wins over KIMI_API_KEY_FILE.
KIMI_API_KEY=
KIMI_API_KEY_FILE=
NVIDIA_API_KEY=
NVIDIA_API_KEY_FILE=
DEEPSEEK_API_KEY=
DEEPSEEK_API_KEY_FILE=
ZAI_API_KEY=
ZAI_API_KEY_FILE=

# Optional self-hosted Kimi K3 (vLLM/SGLang OpenAI-compatible endpoint).
# It stays disabled until exact moonshotai/Kimi-K3 discovery succeeds.
K3_SELF_HOSTED_ENABLED=false
K3_SELF_HOSTED_BASE_URL=http://127.0.0.1:8000/v1
K3_SELF_HOSTED_API_KEY=
K3_SELF_HOSTED_API_KEY_FILE=

# Optional local DS2API DeepSeek fallback. DS2API owns DeepSeek login/session;
# the gateway never receives or stores the DeepSeek account password.
DS2API_ENABLED=false
DS2API_BASE_URL=http://127.0.0.1:5001/v1
DS2API_API_KEY=
DS2API_API_KEY_FILE=
# Production Compose-only DS2API Secret inputs (kept outside this file).
DS2API_CONFIG_JSON_FILE=
DS2API_ADMIN_KEY_FILE=
DS2API_JWT_SECRET_FILE=
DS2API_IMAGE=

# Kimi Code / ACP runtime
KIMI_COMMAND=kimi
KIMI_CODE_HOME=./data/kimi-code-home
DEFAULT_WORKSPACE=./workspace
DEFAULT_MODEL=k3-256k
LONG_CONTEXT_MODEL=k3
DEFAULT_ROLE=orchestrator
DEFAULT_THINKING=high

# Optional JSON customizations. Defaults are built in when files do not exist.
PROVIDER_PROFILES_FILE=./config/provider-profiles.json
ROUTING_FILE=./config/routes.json

# Orchestration limits
ALLOW_EXECUTE_MODE=true
ALLOW_YOLO_MODE=false
MAX_LIVE_SESSIONS=8
MAX_PARALLEL_SUBAGENTS=6
MAX_ROUTE_ATTEMPTS=3
SESSION_IDLE_TTL_SECONDS=3600
APPROVAL_TIMEOUT_SECONDS=600
PROMPT_TIMEOUT_SECONDS=7200
ENABLE_SELF_MCP=true
SELF_MCP_PYTHON=

# Optional browser-session advisory fallback. It can plan/review only and cannot
# bypass CAPTCHA, quotas, account restrictions, or execute local tools.
ENABLE_WEB_ADVISORY_FALLBACK=false
DEEPSEEK_WEB_BRIDGE_URL=http://127.0.0.1:8788/v1
DEEPSEEK_WEB_BRIDGE_KEY=CHANGE_TO_A_SECOND_LOCAL_KEY
GLM_WEB_BRIDGE_URL=http://127.0.0.1:8788/v1
GLM_WEB_BRIDGE_KEY=CHANGE_TO_A_SECOND_LOCAL_KEY

# Browser bridge process (optional)
BROWSER_BRIDGE_HOST=127.0.0.1
BROWSER_BRIDGE_PORT=8788
BROWSER_BRIDGE_API_KEY=CHANGE_TO_A_SECOND_LOCAL_KEY
BROWSER_BRIDGE_PROFILES_FILE=./config/browser-profiles.json
BROWSER_BRIDGE_DATA_DIR=./data/browser-profiles
BROWSER_BRIDGE_HEADLESS=false

# JSON array. Add only trusted project roots outside DEFAULT_WORKSPACE.
ALLOW_PATHS=[]

AUDIT_LOG=./data/audit.jsonl
STATE_FILE=./data/gateway-state.json
