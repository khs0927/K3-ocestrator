[Unit]
Description=K3 Orchestrator health recovery for %i
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/k3-ocestrator
Environment=COMPOSE_FILE=/opt/k3-ocestrator/docker-compose.providers.yml
Environment=COMPOSE_ENV_FILE=/etc/k3-secrets/provider.env
Environment=GATEWAY_ENV_FILE=/etc/k3-secrets/gateway.env
Environment=RECOVERY_STATE_FILE=/var/lib/k3-orchestrator/%i-recovery.last
Environment=RECOVERY_LOCK_DIR=/var/lib/k3-orchestrator/.%i-recovery.lock
Environment=SERVICE=%i
ExecStart=/opt/k3-ocestrator/scripts/compose-health-recover.sh
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/lib/k3-orchestrator

[Install]
WantedBy=multi-user.target
